+// Japanese TGAA 1.0.0: adjust the verified handheld-size trampoline before
+// executable pages are sealed. Never patch another build or an unknown layout.
+static void tgaa_resolution(module_t *m, uint8_t *raw, size_t size) {
+    if (strcmp(m->name, "main") || strcmp(m->build_id, "d871b992e95b71c541ddc834f63c664b")) return;
+    const char *choice = getenv("DM_TGAA_RESOLUTION");
+    if (!choice) return; // Compatibility with previously packaged 1080p apps.
+    unsigned w = 1920, h = 1080;
+    if (!strcmp(choice, "720")) { w = 1280; h = 720; }
+    else if (!strcmp(choice, "1440")) { w = 2560; h = 1440; }
+    else if (!strcmp(choice, "2160")) { w = 3840; h = 2160; }
+    else if (strcmp(choice, "1080")) LOG("[tgaa] unsupported resolution %s; using 1080p", choice);
+    static const uint32_t expected[] = {0x5280f008, 0x52808709, 0x291b2668, 0x17fc67d0, 0};
+    uint32_t branch = 0, pool = 0;
+    if (size < 0x80dd44) die("TGAA resolution: image too short");
+    memcpy(&branch, raw + 0x727c78, 4); memcpy(&pool, raw + 0x1c914, 4);
+    if (branch != 0x1403982e || pool != 0xaa1403e3 || memcmp(raw + 0x80dd30, expected, sizeof expected))
+        die("TGAA resolution: unexpected patch layout; rebuild from the verified profile");
+    if (h == 2160) {
+        uint32_t buffer, width_scale, height_scale;
+        memcpy(&buffer, raw + 0x1c8a0, 4);
+        memcpy(&width_scale, raw + 0x603b68, 4);
+        memcpy(&height_scale, raw + 0x603b78, 4);
+        if (buffer != 0xaa1403e3 || width_scale != 0x1e220821 || height_scale != 0x1e210800)
+            die("TGAA 4K: unexpected allocation instructions");
+        // Supplied target dimensions are already scaled. Avoid allocating 11520x6480
+        // temporarily for a 3840x2160 target; reserve room for scene/model buffers.
+        buffer = 0xd2a32003; width_scale = 0x1e204041; height_scale = 0x1e204020;
+        memcpy(raw + 0x1c8a0, &buffer, 4);
+        memcpy(raw + 0x603b68, &width_scale, 4);
+        memcpy(raw + 0x603b78, &height_scale, 4);
+    }
+    uint32_t code[] = {0x52800008 | (w << 5), 0x52800009 | (h << 5),
+                      0x291b2668, 0x290026e8, 0x17fc67cf};
+    memcpy(raw + 0x80dd30, code, sizeof code);
+    if (h >= 1440) { // Reserve space for high-resolution render targets.
+        pool = 0xd2a00003 | ((1600 * 16) << 5);
+        memcpy(raw + 0x1c914, &pool, 4);
+    }
