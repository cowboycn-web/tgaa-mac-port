index 0000000..6ea5d0a
--- /dev/null
+++ b/dm/mac/button_atlas.c
@@ -0,0 +1,236 @@
+// Build an in-game button font overlay from the game's Chinese-patched font ARC.
+// Copy the cleaned Settings message alongside it; all other font entries stay intact.
+#include <errno.h>
+#include <fcntl.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <zlib.h>
+#include "button_special.h"
+
+enum { TEX_SIZE = 262168, PAYLOAD = 262144, CELL_BLOCKS = 16, PITCH_BLOCKS = 128 };
+typedef struct { size_t pos; uint32_t compressed, size, offset, flags; } arc_entry;
+
+static uint32_t u32(const uint8_t *p) { uint32_t v; memcpy(&v, p, 4); return v; }
+static void w32(uint8_t *p, uint32_t v) { memcpy(p, &v, 4); }
+static int tail(const char *s, const char *suffix) { size_t a = strlen(s), b = strlen(suffix); return a >= b && !strcmp(s + a - b, suffix); }
+static int read_file(const char *path, uint8_t **data, size_t *size) {
+    FILE *f = fopen(path, "rb"); if (!f) return 0;
+    if (fseek(f, 0, SEEK_END) || (long)(*size = (size_t)ftell(f)) < 0 || fseek(f, 0, SEEK_SET) || !(*data = malloc(*size))) { fclose(f); return 0; }
+    int ok = fread(*data, 1, *size, f) == *size; fclose(f);
+    if (!ok) { free(*data); *data = NULL; } return ok;
+}
+static int copy_file(const char *source, const char *target) {
+    FILE *in = fopen(source, "rb"); if (!in) return 0;
+    FILE *out = fopen(target, "wb"); if (!out) { fclose(in); return 0; }
+    uint8_t buffer[16384]; size_t count; int ok = 1;
+    while ((count = fread(buffer, 1, sizeof buffer, in))) if (fwrite(buffer, 1, count, out) != count) { ok = 0; break; }
+    if (ferror(in)) ok = 0;
+    if (fclose(out)) ok = 0;
+    fclose(in);
+    if (!ok) unlink(target);
+    return ok;
+}
+static int find_entry(const uint8_t *arc, size_t n, const char *suffix, arc_entry *out) {
+    if (n < 8 || memcmp(arc, "ARC\0", 4) || arc[4] != 7 || arc[5]) return 0;
+    uint16_t count; memcpy(&count, arc + 6, 2);
+    if (8 + (size_t)count * 0x90 > n) return 0;
+    for (unsigned i = 0; i < count; i++) {
+        size_t pos = 8 + i * 0x90;
+        char name[129]; memcpy(name, arc + pos, 128); name[128] = 0;
+        if (!tail(name, suffix)) continue;
+        uint32_t c = u32(arc + pos + 0x84), marked = u32(arc + pos + 0x88), offset = u32(arc + pos + 0x8c);
+        if ((uint64_t)offset + c > n || !(marked & 0x1fffffff)) return 0;
+        *out = (arc_entry){pos, c, marked & 0x1fffffff, offset, marked & ~0x1fffffff};
+        return 1;
+    }
+    return 0;
+}
+static int unpack_tex(const uint8_t *arc, const arc_entry *e, uint8_t tex[TEX_SIZE]) {
+    if (e->size != TEX_SIZE) return 0;
+    if (e->compressed == TEX_SIZE) memcpy(tex, arc + e->offset, TEX_SIZE);
+    else { uLongf n = TEX_SIZE; if (uncompress(tex, &n, arc + e->offset, e->compressed) != Z_OK || n != TEX_SIZE) return 0; }
+    return !memcmp(tex, "TEX\0", 4) && tex[13] == 0x2a && u32(tex + 8) == 0x10008001;
+}
+// The archive's Switch TEX has a byte permutation over 16-byte BC7 blocks.
+// The order matches the Tegra X1 block-linear layout with tile height 4.
+static void block_order(uint32_t indices[PAYLOAD / 16]) {
+    size_t n = 0; int start = 0, group = 0, step = 512 * 16 - 0x100;
+    while (start < step) {
+        for (int pos = start; pos < PAYLOAD; pos += 0x100 + step) {
+            static const int offsets[] = {0, 0x20, 0x100, 0x120};
+            for (int k = 0; k < 4; k++) indices[n++] = (uint32_t)(pos + offsets[k]);
+        }
+        group++; start += group == 8 ? 0x130 : group & 1 ? 0x10 : 0x30;
+        if (group == 8) group = 0;
+    }
+}
+static void tex_linear(const uint8_t *tex, uint8_t *linear, const uint32_t *order) {
+    for (int i = 0; i < PAYLOAD / 16; i++) memcpy(linear + i * 16, tex + 24 + order[i], 16);
+}
+static void tex_swizzled(uint8_t *tex, const uint8_t *linear, const uint32_t *order) {
+    for (int i = 0; i < PAYLOAD / 16; i++) memcpy(tex + 24 + order[i], linear + i * 16, 16);
+}
+static void cell_copy(uint8_t *dst, int dr, int dc, const uint8_t *src, int sr, int sc) {
+    for (int y = 0; y < CELL_BLOCKS; y++) {
+        size_t a = ((dr * CELL_BLOCKS + y) * PITCH_BLOCKS + dc * CELL_BLOCKS) * 16;
+        size_t b = ((sr * CELL_BLOCKS + y) * PITCH_BLOCKS + sc * CELL_BLOCKS) * 16;
+        memcpy(dst + a, src + b, CELL_BLOCKS * 16);
+    }
+}
+typedef struct { int code, row, col; } pc_key;
+static const pc_key pc_keys[] = {
+    // The game's PC atlas: number row, QWERTY row, ASDF row, ZXCV row.
+    {18,0,0},{19,0,1},{20,0,2},{21,0,3},{23,0,4},{22,0,5},{26,0,6},{28,0,7},
+    {25,1,0},{29,1,1},{12,1,2},{13,1,3},{14,1,4},{15,1,5},{17,1,6},{16,1,7},
+    {32,2,0},{34,2,1},{31,2,2},{35,2,3},{0,2,4},{1,2,5},{2,2,6},{3,2,7},
+    {5,3,0},{4,3,1},{38,3,2},{40,3,3},{37,3,4},{6,3,5},{7,3,6},{8,3,7},
+    {9,4,0},{11,4,1},{45,4,2},{46,4,3},
+    {49,5,7}, // Space
+    {51,6,0}, // the Mac Delete key is Backspace
+    {126,6,7},{125,7,0},{123,7,1},{124,7,2}, // ↑ ↓ ← →
+};
+static int pc_cell(int code, int *r, int *c) {
+    for (size_t i = 0; i < sizeof pc_keys / sizeof *pc_keys; i++) if (pc_keys[i].code == code) {
+        *r = pc_keys[i].row; *c = pc_keys[i].col; return 1;
+    }
+    return 0;
+}
+static const uint8_t *special_keycap(int code) {
+    if (code == 36) return button_keycap_return;
+    if (code == 48) return button_keycap_tab;
+    if (code == 53) return button_keycap_escape;
+    return NULL;
+}
+static void special_copy(uint8_t *dst, int dr, int dc, const uint8_t *keycap) {
+    for (int row = 0; row < CELL_BLOCKS; row++) {
+        size_t a = ((dr * CELL_BLOCKS + row) * PITCH_BLOCKS + dc * CELL_BLOCKS) * 16;
+        memcpy(dst + a, keycap + row * CELL_BLOCKS * 16, CELL_BLOCKS * 16);
+    }
+}
+static void keyboard_cells(uint8_t *dst, const uint8_t *pc, const char *raw) {
+    static const int defaults[21] = {13,0,1,2,38,40,32,34,12,14,6,8,3,5,36,48,123,126,124,125,49};
+    static const struct { int action, row, col; } slots[] = {
+        {4,0,0},{5,0,1},{6,0,2},{7,0,3},
+        {12,1,2},{13,1,3},{8,1,4},{9,1,5},{10,1,6},{11,1,7},
+        {14,2,0},{15,2,1},{17,2,4},{19,2,5},{16,2,6},{18,2,7},
+        {3,3,0},{0,3,1},{1,3,2},{2,3,3},
+    };
+    int keys[21]; memcpy(keys, defaults, sizeof keys);
+    if (raw && *raw) {
+        int parsed[21], valid = 1; const char *p = raw;
+        for (int i = 0; i < 21; i++) {
+            char *end; long v = strtol(p, &end, 10);
+            if (end == p || v < 0 || v > 127 || (i < 20 ? *end != ',' : *end)) { valid = 0; break; }
+            parsed[i] = (int)v; p = end + (i < 20);
+        }
+        if (valid) memcpy(keys, parsed, sizeof keys);
+    }
+    for (size_t i = 0; i < sizeof slots / sizeof *slots; i++) {
+        int row, col;
+        int code = keys[slots[i].action];
+        if (pc_cell(code, &row, &col)) cell_copy(dst, slots[i].row, slots[i].col, pc, row, col);
+        else {
+            const uint8_t *keycap = special_keycap(code);
+            if (keycap) special_copy(dst, slots[i].row, slots[i].col, keycap);
+        }
+    }
+}
+static int write_overlay(const char *source, const char *target, int style, const char *keymap, const uint32_t *order) {
+    uint8_t *arc = NULL, *out = NULL, *linear = NULL, *other = NULL;
+    size_t n = 0; int ok = 0;
+    arc_entry slot, alt;
+    uint8_t orig_tex[TEX_SIZE], alt_tex[TEX_SIZE];
+    if (!read_file(source, &arc, &n) || !find_entry(arc, n, "\\button_swi_00_ID_HQ", &slot)) goto done;
+    const char *suffix = style == 2 ? "\\button_one_00_ID_HQ" : style == 3 ? "\\button_ps4_00_ID_HQ" : "\\button_pc_00_ID_HQ";
+    if (!find_entry(arc, n, suffix, &alt) || !unpack_tex(arc, &slot, orig_tex) || !unpack_tex(arc, &alt, alt_tex)) goto done;
+    linear = malloc(PAYLOAD); other = malloc(PAYLOAD); if (!linear || !other) goto done;
+    tex_linear(orig_tex, linear, order); tex_linear(alt_tex, other, order);
+    if (style == 2 || style == 3) {
+        cell_copy(linear, 0, 0, other, 0, 1); cell_copy(linear, 0, 1, other, 0, 0);
+        cell_copy(linear, 0, 2, other, 0, 3); cell_copy(linear, 0, 3, other, 0, 2);
+        // Use the other controller's shoulder, directional and menu symbols.
+        for (int r = 1; r <= 3; r++) for (int c = 0; c < 8; c++) cell_copy(linear, r, c, other, r, c);
+    } else keyboard_cells(linear, other, keymap);
+    tex_swizzled(orig_tex, linear, order);
+    uLongf compressed = compressBound(TEX_SIZE);
+    uint8_t *packed = malloc(compressed); if (!packed || compress2(packed, &compressed, orig_tex, TEX_SIZE, Z_DEFAULT_COMPRESSION) != Z_OK) { free(packed); goto done; }
+    if (n > UINT32_MAX - compressed) { free(packed); goto done; }
+    out = malloc(n + compressed); if (!out) { free(packed); goto done; }
+    memcpy(out, arc, n); memcpy(out + n, packed, compressed); free(packed);
+    w32(out + slot.pos + 0x84, (uint32_t)compressed);
+    w32(out + slot.pos + 0x88, slot.flags | TEX_SIZE);
+    w32(out + slot.pos + 0x8c, (uint32_t)n);
+    char temp[4096]; if (snprintf(temp, sizeof temp, "%s.tmp", target) >= (int)sizeof temp) goto done;
+    FILE *f = fopen(temp, "wb"); if (!f) goto done;
+    ok = fwrite(out, 1, n + compressed, f) == n + compressed;
+    if (fclose(f)) ok = 0;
+    if (ok) ok = !rename(temp, target);
+    if (!ok) unlink(temp);
+done:
+    free(arc); free(out); free(linear); free(other); return ok;
+}
+
+int dm_mac_button_overlay(const char *resources, const char *output, int style, const char *keymap) {
+    if (style < 1 || style > 4) return 0;
+    char source[4096], target[4096], dir[4096];
+    if (snprintf(dir, sizeof dir, "%s/nativeNXx64", output) >= (int)sizeof dir) return 0;
+    mkdir(output, 0755); mkdir(dir, 0755);
+    if (snprintf(dir, sizeof dir, "%s/nativeNXx64/archive", output) >= (int)sizeof dir) return 0;
+    mkdir(dir, 0755);
+    if (snprintf(source, sizeof source, "%s/button_source/msg_sys_jpn.arc", resources) >= (int)sizeof source ||
+        snprintf(target, sizeof target, "%s/msg_sys_jpn.arc", dir) >= (int)sizeof target) return 0;
+    int have_message = access(source, F_OK) == 0;
+    if (have_message) { if (!copy_file(source, target)) return 0; }
+    else unlink(target);
+    if (style == 1) {
+        // A prior keyboard/controller overlay must not survive a return to Switch.
+        for (int i = 0; i < 2; i++) {
+            snprintf(target, sizeof target, "%s/font_%s.arc", dir, i ? "eng" : "jpn");
+            if (unlink(target) && errno != ENOENT) return 0;
+        }
+        return have_message;
+    }
+    uint32_t *order = malloc((PAYLOAD / 16) * sizeof *order); if (!order) return 0;
+    block_order(order);
+    int ok = 1;
+    for (int i = 0; i < 2; i++) {
+        const char *lang = i ? "eng" : "jpn";
+        if (snprintf(source, sizeof source, "%s/button_source/font_%s.arc", resources, lang) >= (int)sizeof source ||
+            snprintf(target, sizeof target, "%s/font_%s.arc", dir, lang) >= (int)sizeof target ||
+            !write_overlay(source, target, style, keymap, order)) { ok = 0; break; }
+    }
+    free(order); return ok;
+}
+
+// Exact-match runtime atlases: original swizzled bytes followed by four linear BC7 variants.
+// No game memory or Chinese font entries are rewritten by the runtime path.
+int dm_mac_live_icons(const char *resources, const char *output, const char *keymap) {
+    uint32_t order[PAYLOAD / 16]; block_order(order);
+    uint8_t tex[TEX_SIZE], linear[PAYLOAD];
+    char dir[4096], source[4096], dest[4096];
+    mkdir(output, 0755);
+    for (int lang = 0; lang < 2; lang++) {
+        snprintf(dest, sizeof dest, "%s/%s.icons", output, lang ? "eng" : "jpn");
+        FILE *f = fopen(dest, "wb"); if (!f) return 0;
+        int ok = 1;
+        for (int style = 1; style <= 4 && ok; style++) {
+            snprintf(dir, sizeof dir, "%s/style%d", output, style);
+            if (style != 1 && !dm_mac_button_overlay(resources, dir, style, keymap)) { ok = 0; break; }
+            if (style == 1) snprintf(source, sizeof source, "%s/button_source/font_%s.arc", resources, lang ? "eng" : "jpn");
+            else snprintf(source, sizeof source, "%s/nativeNXx64/archive/font_%s.arc", dir, lang ? "eng" : "jpn");
+            uint8_t *arc = NULL; size_t size; arc_entry entry;
+            ok = read_file(source, &arc, &size) && find_entry(arc, size, "\\button_swi_00_ID_HQ", &entry) && unpack_tex(arc, &entry, tex);
+            free(arc); if (!ok) break;
+            if (style == 1) ok = fwrite(tex + 24, 1, PAYLOAD, f) == PAYLOAD;
+            tex_linear(tex, linear, order);
+            ok = ok && fwrite(linear, 1, PAYLOAD, f) == PAYLOAD;
+        }
+        if (fclose(f)) ok = 0;
+        if (!ok) { unlink(dest); return 0; }
+    }
+    return 1;
+}
